{
  "meta": {
    "image_key_path": ["1", "inputs", "image"],
    "min_width": 720,
    "min_height": 1280,
    "_note": [
      "Real-ESRGAN x2 — lighter than x4; good for I2V frame upscaling (480->960).",
      "Required: models/upscale_models/RealESRGAN_x2plus.pth",
      "Used by SHORTS_RENDER_I2V_UPSCALE=realesrgan_comfy when upscaling clause MP4 frames."
    ]
  },
  "prompt": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {"image": "placeholder.png"},
      "_meta": {"title": "LOAD INPUT IMAGE"}
    },
    "2": {
      "class_type": "UpscaleModelLoader",
      "inputs": {"model_name": "RealESRGAN_x2plus.pth"},
      "_meta": {"title": "Real-ESRGAN x2plus"}
    },
    "3": {
      "class_type": "ImageUpscaleWithModel",
      "inputs": {"upscale_model": ["2", 0], "image": ["1", 0]},
      "_meta": {"title": "Real-ESRGAN Upscale x2"}
    },
    "4": {
      "class_type": "SaveImage",
      "inputs": {"images": ["3", 0], "filename_prefix": "upscaled_realesrgan_x2"},
      "_meta": {"title": "SAVE UPSCALED"}
    }
  }
}
