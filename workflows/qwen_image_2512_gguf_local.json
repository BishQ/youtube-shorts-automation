{
  "meta": {
    "prompt_key_path": ["6", "inputs", "text"],
    "seed_key_path": ["8", "inputs", "seed"],
    "min_width": 1080,
    "min_height": 1920,
    "_note": [
      "Qwen-Image-2512 GGUF Q4_K_M — 8GB VRAM optimised, 9:16 portrait.",
      "Pipeline: 832x1472 latent (28 res_multistep steps, CFG 3.0, shift 3.0)",
      "          -> TiledVAEDecode (safe on 8GB) -> 4x UltraSharp upscale.",
      "Final image ~3328x5888; downstream FFmpeg scales to 1080x1920.",
      "",
      "Quality upgrades vs prior workflow:",
      "  - res_multistep / beta scheduler (sharper edges, fewer steps).",
      "  - Tiled VAE decode (no OOM on 8GB at this resolution).",
      "  - Stronger negative prompt (anatomy + AI-tells).",
      "  - Random seed by default (-1 -> ComfyUI randomises).",
      "  - Shift 3.0 (Qwen canonical).",
      "",
      "Required (UNCHANGED — same files as before):",
      "  models/unet/         Qwen-Image-2512-Q4_K_M.gguf",
      "  models/text_encoders qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "  models/vae/          qwen_image_vae.safetensors",
      "  models/upscale_models 4x-UltraSharp.pth",
      "Custom node: ComfyUI-GGUF (city96)."
    ]
  },
  "prompt": {
    "1": {
      "class_type": "UnetLoaderGGUF",
      "inputs": {"unet_name": "qwen-image-2512-Q4_K_M.gguf"},
      "_meta": {"title": "Qwen-Image-2512 GGUF Q4_K_M"}
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
        "type": "qwen_image",
        "device": "default"
      },
      "_meta": {"title": "Qwen 2.5 VL Text Encoder (fp8)"}
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {"vae_name": "qwen_image_vae (1).safetensors"},
      "_meta": {"title": "Qwen-Image VAE"}
    },
    "4": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {"model": ["1", 0], "shift": 3.0},
      "_meta": {"title": "Model Sampling (shift 3.0 — Qwen canonical)"}
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {"width": 832, "height": 1472, "batch_size": 1},
      "_meta": {"title": "Empty Latent 832x1472 (9:16, 8GB-safe)"}
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {"clip": ["2", 0], "text": ""},
      "_meta": {"title": "POSITIVE PROMPT"}
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["2", 0],
        "text": "blurry, soft focus, low resolution, low detail, jpeg artifacts, banding, oversaturated, washed out, plastic skin, waxy skin, smooth skin, airbrushed, doll-like, uncanny, deformed face, asymmetrical eyes, extra fingers, fused fingers, extra limbs, malformed hands, bad anatomy, cross-eyed, lazy eye, mutated, disfigured, watermark, signature, text, letters, logo, caption, frame, border, cropped, cut off, duplicate, tiling, collage"
      },
      "_meta": {"title": "NEGATIVE PROMPT (anatomy + AI-tells)"}
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["4", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0],
        "seed": -1,
        "steps": 28,
        "cfg": 3.0,
        "sampler_name": "res_multistep",
        "scheduler": "beta",
        "denoise": 1.0
      },
      "_meta": {"title": "KSampler (28 res_multistep / beta, CFG 3.0)"}
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["8", 0],
        "vae": ["3", 0]
      },
      "_meta": {"title": "VAE Decode (still image)"}
    },
    "10": {
      "class_type": "UpscaleModelLoader",
      "inputs": {"model_name": "4x-UltraSharp.pth"},
      "_meta": {"title": "4x-UltraSharp"}
    },
    "11": {
      "class_type": "ImageUpscaleWithModel",
      "inputs": {"upscale_model": ["10", 0], "image": ["9", 0]},
      "_meta": {"title": "4x UltraSharp Upscale"}
    },
    "12": {
      "class_type": "SaveImage",
      "inputs": {
        "images": ["11", 0],
        "filename_prefix": "shorts_qwen_2512_gguf"
      },
      "_meta": {"title": "SAVE FINAL"}
    }
  }
}
