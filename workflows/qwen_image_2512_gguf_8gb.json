{
  "meta": {
    "prompt_key_path": ["6", "inputs", "text"],
    "seed_key_path": ["8", "inputs", "seed"],
    "min_width": 1080,
    "min_height": 1920,
    "_note": [
      "Qwen-Image-2512 GGUF Q4 — RTX 8GB profile (5070 Laptop, etc.).",
      "Latent 512x896 (9:16), 10 steps euler, CLIP on CPU — 8GB must use Comfy --lowvram.",
      "No 4x neural upscale (OOM + stalls progress at 0%); ImageScale to 1080x1920 instead.",
      "Models: qwen-image-2512-Q4_K_M.gguf, qwen_2.5_vl_7b_fp8_scaled, qwen_image_vae (1)."
    ]
  },
  "prompt": {
    "1": {
      "class_type": "UnetLoaderGGUF",
      "inputs": {"unet_name": "qwen-image-2512-Q4_K_M.gguf"},
      "_meta": {"title": "Qwen-Image-2512 GGUF Q4_K_M"}
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
        "type": "qwen_image",
        "device": "cpu"
      },
      "_meta": {"title": "Qwen 2.5 VL Text Encoder (fp8)"}
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {"vae_name": "qwen_image_vae (1).safetensors"},
      "_meta": {"title": "Qwen-Image VAE"}
    },
    "4": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {"model": ["1", 0], "shift": 3.0},
      "_meta": {"title": "Model Sampling (shift 3.0)"}
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {"width": 512, "height": 896, "batch_size": 1},
      "_meta": {"title": "Empty Latent 512x896 (9:16, 8GB lite)"}
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {"clip": ["2", 0], "text": ""},
      "_meta": {"title": "POSITIVE PROMPT"}
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["2", 0],
        "text": "blurry, soft focus, low resolution, low detail, jpeg artifacts, banding, oversaturated, washed out, plastic skin, waxy skin, smooth skin, airbrushed, doll-like, uncanny, deformed face, asymmetrical eyes, extra fingers, fused fingers, extra limbs, malformed hands, bad anatomy, cross-eyed, lazy eye, mutated, disfigured, watermark, signature, text, letters, logo, caption, frame, border, cropped, cut off, duplicate, tiling, collage"
      },
      "_meta": {"title": "NEGATIVE PROMPT"}
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["4", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0],
        "seed": -1,
        "steps": 10,
        "cfg": 3.0,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1.0
      },
      "_meta": {"title": "KSampler (14 euler, 8GB-fast)"}
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": {"samples": ["8", 0], "vae": ["3", 0]},
      "_meta": {"title": "VAE Decode"}
    },
    "10": {
      "class_type": "ImageScale",
      "inputs": {
        "image": ["9", 0],
        "upscale_method": "lanczos",
        "width": 1080,
        "height": 1920,
        "crop": "center"
      },
      "_meta": {"title": "Scale to 1080x1920 (no 4x VRAM spike)"}
    },
    "11": {
      "class_type": "SaveImage",
      "inputs": {
        "images": ["10", 0],
        "filename_prefix": "shorts_qwen_8gb"
      },
      "_meta": {"title": "SAVE FINAL"}
    }
  }
}
