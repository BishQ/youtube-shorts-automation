{
  "meta": {
    "prompt_key_path": ["4", "inputs", "text"],
    "min_width": 1080,
    "min_height": 1920,
    "_note": [
      "ComfyUI API-format workflow for local Flux Schnell GGUF generation.",
      "Three stages: 576x1024 base → 2x scale → img2img refine → 4x UltraSharp upscale.",
      "",
      "Required files:",
      "  models/unet/          -> flux1-schnell-Q4_K_M.gguf",
      "  models/clip/          -> t5xxl_fp8_e4m3fn_scaled.safetensors",
      "                        -> clip_l.safetensors",
      "  models/vae/           -> ae.safetensors",
      "  models/upscale_models/-> 4x-UltraSharp.pth",
      "",
      "Required custom node: comfyui-gguf (pip install comfyui-gguf)",
      "",
      "In ComfyUI UI: load workflows/flux_schnell_gguf_9x16_hires.json to visualise.",
      "Output PNG after 4x UltraSharp: ~4608x8192 (9:16). Final MP4 is scaled to SHORTS_VIDEO_WIDTH x HEIGHT (default 1080x1920) in FFmpeg."
    ]
  },
  "prompt": {
    "1": {
      "class_type": "UnetLoaderGGUF",
      "inputs": {
        "unet_name": "flux1-schnell-Q4_K_M.gguf"
      },
      "_meta": {"title": "Load Flux Schnell GGUF"}
    },
    "2": {
      "class_type": "DualCLIPLoader",
      "inputs": {
        "clip_name1": "t5xxl_fp8_e4m3fn_scaled.safetensors",
        "clip_name2": "clip_l.safetensors",
        "type": "flux"
      },
      "_meta": {"title": "Load CLIP"}
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "ae.safetensors"
      },
      "_meta": {"title": "Load VAE"}
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["2", 0],
        "text": ""
      },
      "_meta": {"title": "POSITIVE PROMPT"}
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["2", 0],
        "text": "blurry, deformed, low quality, watermark"
      },
      "_meta": {"title": "NEGATIVE PROMPT"}
    },
    "6": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 576,
        "height": 1024,
        "batch_size": 1
      },
      "_meta": {"title": "Base Latent 576x1024 (9:16)"}
    },
    "7": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["4", 0],
        "negative": ["5", 0],
        "latent_image": ["6", 0],
        "seed": 42,
        "steps": 6,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0
      },
      "_meta": {"title": "KSampler Stage1 (6 steps)"}
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["7", 0],
        "vae": ["3", 0]
      },
      "_meta": {"title": "VAEDecode Stage1"}
    },
    "9": {
      "class_type": "ImageScaleBy",
      "inputs": {
        "image": ["8", 0],
        "upscale_method": "lanczos",
        "scale_by": 2.0
      },
      "_meta": {"title": "Scale 2x to 1152x2048"}
    },
    "10": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": ["9", 0],
        "vae": ["3", 0]
      },
      "_meta": {"title": "VAEEncode Stage2"}
    },
    "11": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["4", 0],
        "negative": ["5", 0],
        "latent_image": ["10", 0],
        "seed": 42,
        "steps": 8,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 0.5
      },
      "_meta": {"title": "KSampler Stage2 (img2img refine, denoise=0.5)"}
    },
    "12": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["11", 0],
        "vae": ["3", 0]
      },
      "_meta": {"title": "VAEDecode Stage2"}
    },
    "13": {
      "class_type": "UpscaleModelLoader",
      "inputs": {
        "model_name": "4x-UltraSharp.pth"
      },
      "_meta": {"title": "Load 4x-UltraSharp"}
    },
    "14": {
      "class_type": "ImageUpscaleWithModel",
      "inputs": {
        "upscale_model": ["13", 0],
        "image": ["12", 0]
      },
      "_meta": {"title": "4x UltraSharp Upscale"}
    },
    "15": {
      "class_type": "SaveImage",
      "inputs": {
        "images": ["14", 0],
        "filename_prefix": "shorts_local"
      },
      "_meta": {"title": "SAVE FINAL OUTPUT"}
    }
  }
}
