{
  "meta": {
    "image_key_path": ["1", "inputs", "image"],
    "min_width": 1080,
    "min_height": 1920,
    "_note": [
      "Standalone 4x UltraSharp upscaler — used for API-generated images",
      "(e.g. Together FLUX) before they enter the FFmpeg pipeline.",
      "",
      "Pipeline:",
      "  1. /upload/image -> node 1 (LoadImage).",
      "  2. 4x-UltraSharp upscale (e.g. 576x1024 -> 2304x4096).",
      "  3. Save PNG; pipeline scales to 1080x1920 in FFmpeg.",
      "",
      "Required (UNCHANGED): models/upscale_models/4x-UltraSharp.pth"
    ]
  },
  "prompt": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {"image": "placeholder.png"},
      "_meta": {"title": "LOAD INPUT IMAGE"}
    },
    "2": {
      "class_type": "UpscaleModelLoader",
      "inputs": {"model_name": "4x-UltraSharp.pth"},
      "_meta": {"title": "4x-UltraSharp"}
    },
    "3": {
      "class_type": "ImageUpscaleWithModel",
      "inputs": {"upscale_model": ["2", 0], "image": ["1", 0]},
      "_meta": {"title": "4x UltraSharp Upscale"}
    },
    "4": {
      "class_type": "SaveImage",
      "inputs": {"images": ["3", 0], "filename_prefix": "upscaled_api"},
      "_meta": {"title": "SAVE UPSCALED"}
    }
  }
}
