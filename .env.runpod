# =============================================================================
# RunPod GPU Pod — copy to .env via:  bash scripts/setup_runpod_env.sh
# Linux paths only. Secrets (Telegram) merge from --merge-secrets or env vars.
# =============================================================================

# ---- Core paths -------------------------------------------------------------
SHORTS_DATA_DIR=./data
SHORTS_WORKFLOWS_DIR=./workflows

# ---- Planner (vLLM on pod :8000 — match scripts/start_vllm.sh) --------------
SHORTS_PLANNER_BACKEND=vllm
SHORTS_LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
SHORTS_LOCAL_LLM_MODEL=qwen3-27b
SHORTS_LOCAL_LLM_TIMEOUT_S=600
SHORTS_LOCAL_LLM_TEMPERATURE=0.4
SHORTS_LOCAL_LLM_PLANNER_TEMPERATURE=0.05
SHORTS_LOCAL_LLM_STRUCTURED_OUTPUT=guided_json
SHORTS_LOCAL_LLM_MAX_TOKENS=8000

# ---- Image (Flux 2 Dev identity — PuLID + InstantID + ControlNet inpaint) ----
SHORTS_IMAGE_BACKEND=flux_identity
SHORTS_FLUX_IDENTITY_WORKFLOW_NAME=flux2_dev_identity_full
SHORTS_FLUX_PULID_MODEL_NAME=pulid_flux2_klein_v2.safetensors
SHORTS_FLUX_PULID_STRENGTH_PRIMARY=1.2
SHORTS_FLUX_PULID_STRENGTH_REF2=0.55
SHORTS_FLUX_PULID_STRENGTH_REF3=0.45
SHORTS_FLUX_PULID_STRENGTH_REF4=0.35
SHORTS_FLUX_CONTROLNET_NAME=FLUX.2-dev-Fun-Controlnet-Union.safetensors
SHORTS_FLUX_INPAINT_CONTROLNET_STRENGTH=0.35
SHORTS_FLUX_INPAINT_DENOISE=0.42
# Upload famous_people_1000 to this path on the pod (RunPod File Manager / rsync).
SHORTS_REFERENCE_IMAGES_ROOT=/workspace/data/famous_people_1000

# ---- ComfyUI (local on pod — scripts/runpod_bootstrap.sh installs models) ----
SHORTS_COMFY_MODE=local
SHORTS_COMFY_BASE_URL=http://127.0.0.1:8188
SHORTS_COMFY_TIMEOUT_S=600
SHORTS_COMFY_POLL_INTERVAL_S=1.0
SHORTS_COMFY_MAX_POLLS=1200
SHORTS_COMFY_CONNECT_MAX_WAIT_S=0
SHORTS_COMFY_CONNECT_RETRY_INTERVAL_S=2.5
SHORTS_COMFY_WORKFLOW_NAME=flux2_dev_identity_full
SHORTS_COMFY_UPSCALE_WORKFLOW_NAME=upscale_4x_ultrasharp

# ---- I2V (LTX 2.3 dev BF16 — scripts/runpod_download_models.py) --------------
SHORTS_I2V_BACKEND=ltx
SHORTS_I2V_WORKFLOW_NAME=ltx23_i2v_full
SHORTS_I2V_ENABLED=true
SHORTS_I2V_MAX_CLIP_DURATION_S=7.5
SHORTS_RENDER_DUAL_OUTPUTS=true

# ---- GPU / runtime ----------------------------------------------------------
SHORTS_GPU_SERIAL_MODE=true
SHORTS_PAUSE_AFTER_EACH_IMAGE=false
SHORTS_IMAGE_PROMPTS_INCLUDE_FIGURE_NAME=true

# ---- TTS (Kokoro in-process) ------------------------------------------------
SHORTS_TTS_BACKEND=kokoro
SHORTS_KOKORO_VOICE=am_adam
SHORTS_KOKORO_SPEED=1.2
SHORTS_KOKORO_LANG_CODE=a

# ---- Narration duration auto-fit --------------------------------------------
SHORTS_NARRATION_FIT_TARGET_S=59
SHORTS_NARRATION_FIT_BAND_MIN_S=57
SHORTS_NARRATION_FIT_BAND_MAX_S=59
SHORTS_NARRATION_FIT_ATEMPO_MAX=1.15
SHORTS_NARRATION_FIT_HARD_CAP_S=59
SHORTS_NARRATION_REPLAN_THRESHOLD_S=65
SHORTS_NARRATION_REPLAN_MAX_ATTEMPTS=3

# ---- Alignment (Whisper) ----------------------------------------------------
SHORTS_GPU_ID=0
SHORTS_ALIGNER_BACKEND=faster_whisper
SHORTS_WHISPER_MODEL_SIZE=small
SHORTS_WHISPER_DEVICE=auto

# ---- Video / FFmpeg ---------------------------------------------------------
SHORTS_FFMPEG_PATH=ffmpeg
SHORTS_FFPROBE_PATH=ffprobe
SHORTS_VIDEO_WIDTH=1080
SHORTS_VIDEO_HEIGHT=1920
SHORTS_VIDEO_FPS=30
SHORTS_RANDOMIZE_CLIP_TRANSITIONS=true

# ---- Watermark --------------------------------------------------------------
SHORTS_WATERMARK_ENABLED=true
SHORTS_WATERMARK_OPACITY=0.42
SHORTS_WATERMARK_PNG_PATH=./extra tools/watermark.png

# ---- End plate --------------------------------------------------------------
SHORTS_END_PLATE_ENABLED=true
SHORTS_END_PLATE_DURATION_S=1.5
SHORTS_END_PLATE_FONT_SIZE=78
SHORTS_END_PLATE_THANKS_TEXT=THANKS FOR WATCHING
SHORTS_END_PLATE_CTA_TEXT=LIKE & SUBSCRIBE
SHORTS_END_PLATE_CTA_FONT_SIZE=52
SHORTS_END_PLATE_CTA_COLOUR=yellow

# ---- Outro / overlay --------------------------------------------------------
SHORTS_OUTRO_IMAGE_BLUR_SIGMA=0
SHORTS_OVERLAY_ENABLED=false
SHORTS_OVERLAY_OPACITY=0.55

# ---- Pacing -----------------------------------------------------------------
SHORTS_SNAP_TO_BGM_BEATS=false
SHORTS_LAST_FRAME_BREATHE_S=0.8
SHORTS_FADE_OUT_DURATION_S=0.6

# ---- Subtitles (ASS) --------------------------------------------------------
SHORTS_ASS_FONT_NAME=Arial Black
SHORTS_ASS_FONT_SIZE=92
SHORTS_ASS_BOLD=true
SHORTS_ASS_OUTLINE=7
SHORTS_ASS_SHADOW=4
SHORTS_ASS_MARGIN_V=235
SHORTS_ASS_BORDER_STYLE=1
SHORTS_ASS_PRIMARY_COLOUR=&H00FFFFFF
SHORTS_ASS_SECONDARY_COLOUR=&H55FFFFFF
SHORTS_ASS_OUTLINE_COLOUR=&H00000000
SHORTS_ASS_BACK_COLOUR=&H00000000
SHORTS_SUBTITLE_HIGHLIGHT_COLOR=&H0000FFFF
SHORTS_SUBTITLE_ACTIVE_TEXT_COLOUR=&H00000000
SHORTS_SUBTITLE_INACTIVE_ALPHA=&H55
SHORTS_SUBTITLE_CHUNK_SIZE=3
SHORTS_SUBTITLE_MAX_CHUNK_CHARS=16
SHORTS_SUBTITLE_MIN_GROUP_DURATION_S=1.2
SHORTS_SUBTITLE_EMPHASIS_GLOW=&H001040FF

# ---- Assets / grade ---------------------------------------------------------
SHORTS_ASSETS_DIR=./assets
SHORTS_LUTS_DIR=./assets/luts
SHORTS_SFX_DIR=./assets/sfx
SHORTS_GRAIN_STRENGTH=8
SHORTS_VIGNETTE_ANGLE=0.628
SHORTS_DEFAULT_BGM_PATH=./extra tools/bgm.mp3

# ---- BGM mix ----------------------------------------------------------------
SHORTS_BGM_VOLUME_NARRATION=0.48
SHORTS_BGM_VOLUME_NARRATION_DB=-3.5
SHORTS_BGM_SIDECHAIN_THRESHOLD=0.08
SHORTS_BGM_SIDECHAIN_RATIO=2.5
SHORTS_NARRATION_TAIL_SILENCE_PAD_S=0.0

# ---- Render duration --------------------------------------------------------
SHORTS_RENDER_MAX_SHORTS_DURATION_S=59.3
SHORTS_RENDER_LONG_VERSION_ENABLED=true
SHORTS_RENDER_LONG_VERSION_SPEED=0.9
SHORTS_OUTRO_TARGET_TOTAL_S=59.3

# ---- Telegram (filled by setup_runpod_env.sh --merge-secrets or env vars) ----
SHORTS_TG_API_ID=
SHORTS_TG_API_HASH=
SHORTS_TG_TARGET_CHAT=
SHORTS_TG_INVITE_LINK=
SHORTS_TG_SESSION_PATH=./tg_session
SHORTS_TG_TOPICS_PATH=./config/tg_topics.json
SHORTS_TG_FORUM_TOPICS_ENABLED=true
SHORTS_TG_DEFAULT_NICHE=documentary
SHORTS_TG_ASYNC_SEND=true
SHORTS_TG_SEND_ARCHIVE=true

# ---- Logging ----------------------------------------------------------------
SHORTS_LOG_LEVEL=INFO
SHORTS_LOG_JSON=false
