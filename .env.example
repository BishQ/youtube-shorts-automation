# Copy to .env and adjust. Secrets only via environment — never commit .env.

SHORTS_DATA_DIR=./data

# ── Planner backend ──────────────────────────────────────────────────────────
# "gemini"  → Gemini API only (fast, 1500 req/day free). When the daily quota
#             is hit the pipeline pauses until midnight PT then retries.
# "hybrid"  → Try Gemini every job; on quota/rate-limit use DeepSeek for that
#             job only, then try Gemini again on the next job (automatic switch-back).
SHORTS_PLANNER_BACKEND=gemini

# Gemini (used when SHORTS_PLANNER_BACKEND=gemini, auto, or hybrid)
# Get a free key at https://aistudio.google.com/app/apikey
SHORTS_GEMINI_API_KEY=your_gemini_api_key_here
SHORTS_GEMINI_MODEL=gemini-2.5-flash
# Optional: comma-separated list, tried in order when a model hits RPM/daily quota.
# When set, this list is used; SHORTS_GEMINI_MODEL is ignored for ordering (still
# set a sensible default for tools that only read SHORTS_GEMINI_MODEL).
# SHORTS_GEMINI_MODEL_CHAIN=gemini-2.5-flash,gemini-3.1-flash-lite,gemini-3-flash-preview

# DeepSeek (required when SHORTS_PLANNER_BACKEND=hybrid)
# https://api.deepseek.com — OpenAI-compatible; key from https://platform.deepseek.com
# SHORTS_DEEPSEEK_API_KEY=your_deepseek_key_here
# SHORTS_DEEPSEEK_BASE_URL=https://api.deepseek.com
# SHORTS_DEEPSEEK_MODEL=deepseek-chat
# SHORTS_DEEPSEEK_TIMEOUT_S=120

# TTS: kokoro = in-process Python | kokoro_http = separate HTTP server | fish = Fish Speech
SHORTS_TTS_BACKEND=kokoro
SHORTS_KOKORO_VOICE=af_heart
SHORTS_KOKORO_SPEED=1.0
# American English=a, British=b (see Kokoro docs for your voice list)
SHORTS_KOKORO_LANG_CODE=a
# If SHORTS_TTS_BACKEND=kokoro_http:
# SHORTS_KOKORO_HTTP_BASE_URL=http://127.0.0.1:8880
# SHORTS_KOKORO_HTTP_TIMEOUT_S=120
# ── Image backend ────────────────────────────────────────────────────────────
# "comfy"  → All images via local ComfyUI (default, no API key needed).
# "hybrid" → Even clauses + last → Flux API (BFL or Together); second-to-last + odd
#            gaps → local Comfy. Requires SHORTS_FLUX_API_KEY.
# "hybrid_grok_bookends" → First + last (+ optional SHORTS_GROK_EXTRA_CLAUSE_INDICES)
#            → Grok Imagine (figure name prepended); all other clauses → local Comfy.
#            Requires SHORTS_GROK_API_KEY only.
# "hybrid_grok_flux" → Same Grok slots as above + Flux for remaining hybrid API slots
#            + local Comfy for the rest. Requires SHORTS_GROK_API_KEY AND SHORTS_FLUX_API_KEY.
SHORTS_IMAGE_BACKEND=comfy

SHORTS_COMFY_BASE_URL=http://127.0.0.1:8188
SHORTS_COMFY_TIMEOUT_S=600
# If ComfyUI is not running: retry TCP instead of failing (e.g. WinError 10061 connection refused).
# 0 = retry until Comfy starts (cancel the job to stop). Example cap: 600 (= 10 min).
# SHORTS_COMFY_CONNECT_MAX_WAIT_S=0
# SHORTS_COMFY_CONNECT_RETRY_INTERVAL_S=2.5
# Optional default BGM when reconciling a folder that has no job row yet (UI / import_meta.json override this).
# SHORTS_DEFAULT_BGM_PATH=./extra tools/bgm.mp3
# Workflow for local image generation (used by both backends)
SHORTS_COMFY_WORKFLOW_NAME=flux_schnell_local
# Workflow for upscaling API-generated images (hybrid mode only)
SHORTS_COMFY_UPSCALE_WORKFLOW_NAME=upscale_4x_ultrasharp

# ── Remote Flux images (required when IMAGE_BACKEND=hybrid) ───────────────────
# SHORTS_FLUX_API_PROVIDER=bfl       # Black Forest Labs (default)
# SHORTS_FLUX_API_PROVIDER=together  # Together AI — FLUX.2 [pro] etc.
#
# Key: BFL → https://api.bfl.ml  |  Together → https://api.together.ai
# SHORTS_FLUX_API_KEY=your_key_here
#
# Model must match the provider:
#   bfl:      flux-pro-1.1, flux-pro-2, …
#   together: black-forest-labs/FLUX.2-pro  (see Together docs / model list)
# SHORTS_FLUX_API_MODEL=flux-pro-1.1
# SHORTS_FLUX_API_MODEL=black-forest-labs/FLUX.2-pro
#
# Images at FLUX_API_WIDTH × FLUX_API_HEIGHT (lower-res saves cost); Comfy upscales after.
# SHORTS_FLUX_API_WIDTH=576
# SHORTS_FLUX_API_HEIGHT=1024
# BFL only (async poll):
# SHORTS_FLUX_API_BASE_URL=https://api.us1.bfl.ai
# SHORTS_FLUX_API_POLL_INTERVAL_S=2.0
# SHORTS_FLUX_API_MAX_POLLS=90
# Together only (single request timeout):
# SHORTS_TOGETHER_API_BASE_URL=https://api.together.ai
# SHORTS_FLUX_TOGETHER_TIMEOUT_S=300

# ── xAI Grok Imagine (when SHORTS_IMAGE_BACKEND=hybrid_grok_bookends) ───────────
# https://docs.x.ai/docs/guides/image-generations
# SHORTS_GROK_API_KEY=your_xai_api_key_here
# SHORTS_GROK_API_BASE_URL=https://api.x.ai/v1
# SHORTS_GROK_IMAGE_MODEL=grok-imagine-image-quality
# SHORTS_GROK_TIMEOUT_S=180
# Optional 0-based clause indices for 1–2 extra emotional mid-shots via Grok (same name prefix):
# SHORTS_GROK_EXTRA_CLAUSE_INDICES=6,7

SHORTS_FISH_BASE_URL=http://127.0.0.1:5000
SHORTS_FISH_TIMEOUT_S=120
SHORTS_GPU_ID=0
SHORTS_ALIGNER_BACKEND=faster_whisper
SHORTS_WHISPER_MODEL_SIZE=base
SHORTS_FFMPEG_PATH=ffmpeg
SHORTS_FFPROBE_PATH=ffprobe
# BGM: see SHORTS_BGM_* block below (volume, ducking, optional dB override).
SHORTS_VIDEO_WIDTH=1080
SHORTS_VIDEO_HEIGHT=1920
SHORTS_VIDEO_FPS=30
# Each image→image cut picks a random FFmpeg xfade preset (full ~58-pack). false = fixed ladder.
SHORTS_RANDOMIZE_CLIP_TRANSITIONS=true
# Optional fixed RNG seed for transition order (omit = derive from job id per render).
# SHORTS_TRANSITION_RANDOM_SEED=12345
# BGM under voice: linear gain after ducking (0.35–0.65 typical). Your old 0.22 is very quiet.
SHORTS_BGM_VOLUME_NARRATION=0.48
# Optional dB boost after sidechain (overrides linear when set), e.g. -3 for louder bed.
SHORTS_BGM_VOLUME_NARRATION_DB=-3.5
# Ducking: higher threshold = less aggressive duck on noise; lower ratio = gentler pump.
SHORTS_BGM_SIDECHAIN_THRESHOLD=0.08
SHORTS_BGM_SIDECHAIN_RATIO=2.5
# Extra silence after TTS in the narration timeline (pacing + mux; no re-TTS). Example: 4.5s on ~54s voice → ~58.5s body before breathe/end plate. Re-run align after changing.
# SHORTS_NARRATION_TAIL_SILENCE_PAD_S=4.5
SHORTS_WATERMARK_ENABLED=false
SHORTS_WATERMARK_OPACITY=0.15
# SHORTS_WATERMARK_PNG_PATH=C:\assets\wm.png
SHORTS_END_PLATE_ENABLED=false
SHORTS_END_PLATE_DURATION_S=1.5
SHORTS_LOG_LEVEL=INFO
SHORTS_LOG_JSON=false
